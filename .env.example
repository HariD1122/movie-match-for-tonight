# ---- Gemini (title-pool refinement + learning from history) ----
# This is the brief engine. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override. Google retires ids without notice; the app falls back to
# gemini-flash-latest on its own if this one is gone.
GEMINI_MODEL=gemini-3.6-flash

# ---- Claude (optional) ----
# Set this to run the brief on Claude instead. Leave empty to stay on Gemini.
ANTHROPIC_API_KEY=

# ---- TMDB (titles, posters, metadata) ----
# Either works. The v4 read access token is preferred.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# ---- RapidAPI (Indian OTT availability + IMDb rating) ----
# Subscribe to "Streaming Availability" on RapidAPI, then paste the key.
RAPIDAPI_KEY=
RAPIDAPI_HOST=streaming-availability.p.rapidapi.com

# ---- Supabase (session + swipe history) ----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Public origin used to build the QR / share link. Must be reachable from
# your partner's phone (use your LAN IP in dev, e.g. http://192.168.1.5:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000
